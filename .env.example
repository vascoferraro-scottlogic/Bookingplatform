# Copy to .env (or run `npm run setup:env`, which also fills in the secret).
# The values below are local-development defaults.

# ─── Core ─────────────────────────────────────────────────────
# PostgreSQL connection string. Local install defaults to port 5432; use the
# port your server actually listens on if you have more than one Postgres.
# No sslmode for a local database (add ?sslmode=require only for hosted ones).
DATABASE_URL="postgresql://booking:booking@localhost:5432/bookingplatform"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Required. Leave empty here and run `npm run setup:env` (creates .env with a
# generated secret), or generate one yourself: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ─── Payments ─────────────────────────────────────────────────
# Payment provider selection (dev default: stub)
PAYMENT_PROVIDER=stub

# Stub mode: immediate | webhook | manual
# - immediate: charges are marked PAID synchronously (fast, deterministic)
# - webhook: provider returns PENDING and posts a webhook to /api/payments/webhook after a short delay
# - manual: no auto-action; use the admin simulate endpoint to inject events
PAYMENT_STUB_MODE=immediate

# Booking-payment webhook (/api/bookings/webhook): HMAC-SHA256 secret for the
# x-payment-signature header. REQUIRED, with no default: while it is unset every
# event is rejected. Any long random string works for local use.
PAYMENT_WEBHOOK_SECRET=""

# Platform-payment webhook (/api/payments/webhook): events must carry
# `Authorization: Bearer $PAYMENT_STUB_SECRET`. Needed for webhook-mode stub
# payments and scripts/run-billing.mjs. Set it to any string for local use.
PAYMENT_STUB_SECRET="dev-payment-secret"
# Development only: accept UNSIGNED events on /api/payments/webhook (for
# example from Postman). Never set to true on a shared or hosted environment.
PAYMENT_WEBHOOK_ALLOW_UNSIGNED=false

# Base URL used by the stub provider when firing webhooks back to the app
PAYMENT_STUB_WEBHOOK_BASE=http://localhost:3000

# Safety: prevent accidental activation of the stub in production
# Set to true only with extreme caution and awareness of risks.
ALLOW_STUB_IN_PROD=false

# ─── Proxy / rate limiting ────────────────────────────────────
# Set to 1 ONLY when the app sits behind a reverse proxy you control that sets
# x-forwarded-for / x-real-ip. Off by default so clients cannot spoof their IP
# to dodge rate limits.
TRUSTED_PROXY_HEADERS=0

# ─── Agent Framework ──────────────────────────────────────────
# LLM provider: "stub" (default, no-op decisions, no key needed) or "gemini".
AGENT_LLM_PROVIDER="stub"

# Google Gemini API key — free tier available at https://aistudio.google.com/.
# Only used when AGENT_LLM_PROVIDER="gemini".
AGENT_GEMINI_API_KEY=""
AGENT_GEMINI_MODEL="gemini-2.5-flash"

# Weather provider for the Triage Agent. Get a key at
# https://openweathermap.org/api (free One Call API 3.0).
AGENT_OWM_API_KEY=""

# Shared secret for the agent run endpoint and the agent/billing scripts
# (npm run agent:*, scripts/run-billing.mjs). Sent as
# `Authorization: Bearer $AGENT_SECRET`. Defined ONCE; set any string locally.
AGENT_SECRET="change-me"

# Base URL for the run-agent CLI script. Defaults to http://localhost:3000.
AGENT_BASE_URL=""

# Detection Agent: max chat messages to fetch per run.
AGENT_BATCH_SIZE="200"

# ─── Feature flags / Unleash (#feature-management) ────────────
# Control plane for platform rollout flags. When UNLEASH_URL and
# UNLEASH_API_TOKEN are BOTH set, isFeatureEnabled() routes platform-rollout
# flags to Unleash; otherwise every flag reads Postgres (the pre-cutover
# default — no behaviour change). Server-side only: never expose as NEXT_PUBLIC.
#
# Local dev: `docker compose up unleash` serves the Admin UI on :4242.
# Create a backend (client) token in the Unleash UI and paste it below.
UNLEASH_URL="http://localhost:4242/api/"
UNLEASH_API_TOKEN=""
UNLEASH_APP_NAME="bookingplatform"
# Personal access token (PAT) for the Admin API. The RUNNING APP never needs
# this — only the ops scripts (flags:migrate, flags:parity) do. Format
# `<user>:<hash>`. See docs/unleash-runbook.md.
UNLEASH_ADMIN_TOKEN=""

# ─── Hosting / blue-green (#hosting) ──────────────────────────
# Which colour this container is. Set per-container by docker-compose
# (app-blue → blue, app-green → green). Surfaces in /api/health and tags
# every observability event for blue/green attribution.
APP_COLOR="blue"

# Release identifier. In Docker builds (no .git) this is passed as a build
# arg; locally next.config derives it from git. Used as the observability
# `release` tag and the X-App-Version response header.
APP_VERSION=""

# ─── Observability: Better Stack (#hosting) ───────────────────
# When a source token is set, errors + structured events ship to Better
# Stack via @logtail/next; otherwise the app logs structured JSON to stdout
# only (visible via `docker compose logs`). Find these values under your
# Better Stack telemetry source → Connect. Server-side capture reads them at
# runtime, so they can be supplied to the running container (not only at build).
NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=""
NEXT_PUBLIC_BETTER_STACK_INGESTING_URL=""
