// --- ML ModelOps ---

enum MlModelStatus {
  TRAINING   // Training in progress (written by Python at start of train run)
  TRAINED    // Training complete; candidate awaiting promotion gate
  ACTIVE     // Currently serving predictions (champion)
  ARCHIVED   // Superseded by a newer ACTIVE version
  REJECTED   // Failed the champion/challenger promotion gate
  FAILED     // Training error
}

enum MlFeatureStatus {
  AVAILABLE  // Compute exists; not yet enrolled for training
  ENROLLED   // Included in the ColumnTransformer for training
  RETIRED    // Previously enrolled; excluded from future training runs
}

enum MlFeatureKind {
  NUMERIC
  CATEGORICAL
}

enum MlDriftStatus {
  HEALTHY
  WARN
  DRIFT
}

/// One row per trained model artifact. Records the version identifier,
/// training metrics, feature set used, and lifecycle status.
model MlModelVersion {
  id               String         @id @default(cuid())
  version          String         @unique   // e.g. "noshow-v2"
  status           MlModelStatus  @default(TRAINING)
  artifactPath     String?                  // path to joblib on disk / volume
  trainedAt        DateTime?                // set when status → TRAINED
  promotedAt       DateTime?                // set when status → ACTIVE
  rowsTotal        Int?
  rowsTrain        Int?
  rowsTest         Int?
  labelRate        Float?
  rocAuc           Float?
  averagePrecision Float?
  brier            Float?
  precision        Float?
  recall           Float?
  f1               Float?
  threshold        Float?
  featureSet       String?                  // JSON array of enrolled feature keys
  coefficients     String?                  // JSON { featureName: coefValue } for importance panel
  notes            String?
  driftChecks      MlDriftCheck[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
}

/// Per-feature definition. Compute lives in features.py; enrollment is config.
/// Operator enrolls AVAILABLE → ENROLLED; next retrain picks it up.
model MlFeatureDefinition {
  key              String          @id      // e.g. "lead_time_days"
  label            String                   // human-readable display name
  kind             MlFeatureKind
  status           MlFeatureStatus @default(AVAILABLE)
  description      String?
  enrolledAt       DateTime?
  retiredAt        DateTime?
  addedInVersion   String?                  // first model version this featured in
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

/// One row per drift-check run. Written by Python drift.py via the sidecar.
model MlDriftCheck {
  id               String        @id @default(cuid())
  modelVersion     String
  checkedAt        DateTime      @default(now())
  windowStart      DateTime
  windowEnd        DateTime
  sampleCount      Int
  rocAuc           Float?
  calibrationError Float?        // Expected Calibration Error (ECE)
  positiveRate     Float?
  deltaRocAuc      Float?        // vs training rocAuc (negative = degraded)
  deltaCalibration Float?
  status           MlDriftStatus
  version          MlModelVersion @relation(fields: [modelVersion], references: [version])

  @@index([modelVersion, checkedAt])
  @@index([status, checkedAt])
}


// --- Workflow Engine Models ---

enum WorkflowDomain {
  FUNDING
  BOOKING
  CONTENT
  MAINTENANCE
}

model WorkflowDefinition {
  id           String              @id @default(cuid())
  domain       WorkflowDomain
  tenantId     String?             // null = platform default
  name         String
  description  String?
  version      Int                 @default(1)
  isActive     Boolean             @default(false)
  stages       WorkflowStage[]
  transitions  WorkflowTransition[]
  runs         WorkflowRun[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model WorkflowStage {
  id           String              @id @default(cuid())
  definitionId String
  slug         String
  label        String
  sortOrder    Int                 @default(0)
  isInitial    Boolean             @default(false)
  isTerminal   Boolean             @default(false)
  color        String?
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  definition   WorkflowDefinition  @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  fromTransitions WorkflowTransition[] @relation("FromStage")
  toTransitions   WorkflowTransition[] @relation("ToStage")
  currentRuns     WorkflowRun[]        @relation("CurrentStage")
  logFrom         WorkflowTransitionLog[] @relation("LogFromStage")
  logTo           WorkflowTransitionLog[] @relation("LogToStage")
}

model WorkflowTransition {
  id                  String              @id @default(cuid())
  definitionId        String
  fromStageId         String
  toStageId           String
  label               String
  conditions          Json?
  requiredPermissions Permission[]
  requiredGroupIds    String[]
  sortOrder           Int                 @default(0)
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  definition          WorkflowDefinition  @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  fromStage           WorkflowStage       @relation("FromStage", fields: [fromStageId], references: [id], onDelete: Cascade)
  toStage             WorkflowStage       @relation("ToStage", fields: [toStageId], references: [id], onDelete: Cascade)
  logs                WorkflowTransitionLog[]
}

model WorkflowRun {
  id             String              @id @default(cuid())
  definitionId   String
  entityType     String
  entityId       String
  tenantId       String
  currentStageId String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  definition     WorkflowDefinition  @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  currentStage   WorkflowStage       @relation("CurrentStage", fields: [currentStageId], references: [id], onDelete: Cascade)
  logs           WorkflowTransitionLog[]
}

model WorkflowTransitionLog {
  id            String            @id @default(cuid())
  runId         String
  fromStageId   String
  toStageId     String
  transitionId  String
  performedById String
  metadata      Json?
  createdAt     DateTime          @default(now())
  run           WorkflowRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  fromStage     WorkflowStage     @relation("LogFromStage", fields: [fromStageId], references: [id], onDelete: Cascade)
  toStage       WorkflowStage     @relation("LogToStage", fields: [toStageId], references: [id], onDelete: Cascade)
  transition    WorkflowTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  performedBy   User              @relation("UserWorkflowTransitionLogs", fields: [performedById], references: [id])
}

enum FundingResponseSource {
  MANUAL
  AI_DRAFT
  AI_APPROVED
}
