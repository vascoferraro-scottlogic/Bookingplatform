generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                        String                   @id @default(cuid())
  name                      String
  slug                      String                   @unique
  active                    Boolean                  @default(true)
  brandColor                String                   @default("#16a34a")
  logoUrl                   String?
  locale                    String                   @default("en")
  seasonStart               String?
  seasonEnd                 String?
  openingTime               String                   @default("08:00")
  closingTime               String                   @default("20:00")
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  latitude                  Float?
  longitude                 Float?
  status                    TenantStatus             @default(ACTIVE)
  goLiveAt                  DateTime?
  financialYearEndDay       Int?
  financialYearEndMonth     Int?
  organisationType          OrganisationType?
  locality                  String?
  country                   Country                  @default(OTHER)
  vertical                  Vertical                 @default(BOWLS)
  agentMetrics              AgentConfidenceMetrics[]
  agentConfigs              AgentConfig[]
  agentDecisions            AgentDecision[]
  agentKnowledge            AgentKnowledge[]
  agentMemories             AgentMemory[]
  agentProposals            AgentProposal[]
  agentRuns                 AgentRun[]
  auditEvents               AuditEvent[]
  federationBookingsMade    Booking[]                @relation("BookingsByHomeTenant")
  bookings                  Booking[]
  bookingNoShowPredictions  BookingNoShowPrediction[]
  channels                  Channel[]
  charityAssetLiabilities   CharityAssetLiability[]
  charityCategories         CharityCategory[]
  charityFinancialYears     CharityFinancialYear[]
  charityFunds              CharityFund[]
  charitySettings           CharitySettings?
  charityTARs               CharityTAR[]
  charityTransactions       CharityTransaction[]
  contentSections           ContentSection[]
  events                    Event[]
  featureFlags              FeatureFlag[]
  createdFederations        Federation[]             @relation("FederationCreatedBy")
  receivedFederationInvites FederationInvite[]       @relation("FederationInvitesReceived")
  sentFederationInvites     FederationInvite[]       @relation("FederationInvitesSent")
  federationMemberships     FederationMembership[]
  fundingApplications       FundingApplication[]
  fundingOpportunities      FundingOpportunity[]     @relation("TenantFundingOpportunities")
  fundingOpportunityPrefs   FundingOpportunityPref[]
  greens                    Green[]
  helpOverrides             HelpArticleOverride[]
  impersonations            Impersonation[]
  maintenanceHistory        MaintenanceHistory[]
  tasks                     MaintenanceTask[]
  memberships               Membership[]
  messages                  Message[]
  notifications             Notification[]
  onboardingProgress        OnboardingProgress?
  outboundMessages          OutboundMessage[]
  permissionGroups          PermissionGroup[]
  sentimentSnapshots        SentimentSnapshot[]
  streamSessions            StreamSession[]
  streamTokens              StreamToken[]
  agentBudget               TenantAgentBudget?
  application               TenantApplication?
  billingProfile            TenantBillingProfile?
  tenantPayments            TenantPayment[]
  subscription              TenantSubscription?
  trackingEvents            TrackingEvent[]
  users                     User[]
  invitations               UserInvitation[]
}

model User {
  id                         String                @id @default(cuid())
  email                      String                @unique
  name                       String?
  passwordHash               String
  role                       Role                  @default(USER)
  suspended                  Boolean               @default(false)
  tenantId                   String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  isPlatformAdmin            Boolean               @default(false)
  profession                 String?
  qualifications             String?
  specialisms                String?
  agentDefinition            AgentDefinition?
  agentFeedback              AgentFeedback[]
  agentKnowledgeAuthor       AgentKnowledge[]      @relation("KnowledgeCreatedBy")
  auditEvents                AuditEvent[]
  bookingsCreated            Booking[]             @relation("BookingsCreatedBy")
  bookings                   Booking[]
  createdChannels            Channel[]             @relation("ChannelCreatedBy")
  channelMemberships         ChannelMember[]
  createdSections            ContentSection[]      @relation("CreatedBy")
  updatedSections            ContentSection[]      @relation("UpdatedBy")
  createdEvents              Event[]               @relation("EventCreatedBy")
  updatedEvents              Event[]               @relation("EventUpdatedBy")
  fundingApplicationsCreated FundingApplication[]
  workflowTransitionLogs     WorkflowTransitionLog[] @relation("UserWorkflowTransitionLogs")
  createdHelpOverrides       HelpArticleOverride[] @relation("HelpOverrideCreatedBy")
  updatedHelpOverrides       HelpArticleOverride[] @relation("HelpOverrideUpdatedBy")
  impersonations             Impersonation[]
  maintenanceHistoryEntries  MaintenanceHistory[]  @relation("HistoryPerformedBy")
  assignedTasks              MaintenanceTask[]     @relation("AssignedTo")
  submittedTasks             MaintenanceTask[]     @relation("SubmittedBy")
  memberships                Membership[]
  messages                   Message[]
  notifications              Notification[]
  passwordResetTokens        PasswordResetToken[]
  createdStreams             StreamSession[]       @relation("StreamCreatedBy")
  createdTokens              StreamToken[]         @relation("TokenCreatedBy")
  streamViewers              StreamViewer[]        @relation("StreamViewers")
  taskNotes                  TaskNote[]
  trackingEvents             TrackingEvent[]
  tenant                     Tenant?               @relation(fields: [tenantId], references: [id])
  sentInvitations            UserInvitation[]      @relation("InvitationsSent")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model FeatureFlag {
  id       String  @id @default(cuid())
  tenantId String
  key      String
  enabled  Boolean @default(false)
  tenant   Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
}

model Green {
  id                 String               @id @default(cuid())
  name               String
  tenantId           String
  allWeather         Boolean              @default(false)
  seasonStartMMDD    String?
  seasonEndMMDD      String?
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  seasons            GreenSeason[]
  maintenanceHistory MaintenanceHistory[] @relation("GreenHistory")
  rinks              Rink[]
}

model GreenSeason {
  id        String   @id @default(cuid())
  greenId   String
  year      Int
  startDate String
  endDate   String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  green     Green    @relation(fields: [greenId], references: [id], onDelete: Cascade)

  @@unique([greenId, year])
}

model Rink {
  id             String          @id @default(cuid())
  name           String
  greenId        String
  bookingSlots   BookingSlot[]
  green          Green           @relation(fields: [greenId], references: [id])
  streamSessions StreamSession[]
}

model TenantSubscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  tier                 StreamingTier      @default(NONE)
  maxConcurrentStreams Int                @default(0)
  archiveRetentionDays Int                @default(0)
  priceMonthlyPence    Int                @default(0)
  status               SubscriptionStatus @default(ACTIVE)
  activeSince          DateTime           @default(now())
  expiresAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id])
}

model StreamSession {
  id           String           @id @default(cuid())
  tenantId     String
  rinkId       String
  eventId      String?
  title        String
  status       StreamStatus     @default(IDLE)
  visibility   StreamVisibility @default(MEMBERS_ONLY)
  streamKey    String           @unique @default(cuid())
  archiveUrl   String?
  thumbnailUrl String?
  createdById  String
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  createdBy    User             @relation("StreamCreatedBy", fields: [createdById], references: [id])
  event        Event?           @relation(fields: [eventId], references: [id])
  rink         Rink             @relation(fields: [rinkId], references: [id])
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  tokens       StreamToken[]
  viewers      StreamViewer[]

  @@index([tenantId, status])
  @@index([rinkId, status])
}

model StreamViewer {
  id                 String             @id @default(cuid())
  streamSessionId    String
  userId             String?
  sessionFingerprint String
  accessMethod       StreamAccessMethod @default(AUTHENTICATED)
  tokenId            String?
  joinedAt           DateTime           @default(now())
  leftAt             DateTime?
  durationSeconds    Int?
  streamSession      StreamSession      @relation(fields: [streamSessionId], references: [id])
  user               User?              @relation("StreamViewers", fields: [userId], references: [id])

  @@index([streamSessionId, joinedAt])
  @@index([userId])
}

model StreamToken {
  id              String        @id @default(cuid())
  streamSessionId String
  tenantId        String
  token           String        @unique @default(cuid())
  expiresAt       DateTime
  maxUses         Int?
  useCount        Int           @default(0)
  createdById     String
  createdAt       DateTime      @default(now())
  createdBy       User          @relation("TokenCreatedBy", fields: [createdById], references: [id])
  streamSession   StreamSession @relation(fields: [streamSessionId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id])

  @@index([token])
}

model Booking {
  id               String          @id @default(cuid())
  tenantId         String
  userId           String
  date             String
  status           BookingStatus   @default(REQUESTED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  bookedByUserId   String?
  adminOverride    Boolean         @default(false)
  overrideReason   String?
  bookedByTenantId String?
  federationId     String?
  bookedByTenant   Tenant?         @relation("BookingsByHomeTenant", fields: [bookedByTenantId], references: [id])
  bookedByUser     User?           @relation("BookingsCreatedBy", fields: [bookedByUserId], references: [id])
  federation       Federation?     @relation(fields: [federationId], references: [id])
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  payment          BookingPayment?
  noShowPredictions BookingNoShowPrediction[]
  slots            BookingSlot[]
  waitlistEntries  WaitlistEntry[]

  @@index([bookedByUserId])
  @@index([bookedByTenantId])
  @@index([federationId])
}

model BookingSlot {
  id         String  @id @default(cuid())
  bookingId  String
  rinkId     String
  timeSlot   String
  playerName String?
  greenName  String?
  booking    Booking @relation(fields: [bookingId], references: [id])
  rink       Rink    @relation(fields: [rinkId], references: [id])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  bookingId String
  userId    String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
}

/// One row per booking scored by the no-show ML model. Stores predictions
/// for ALL upcoming bookings (not just high-risk ones), so eval can compute
/// a proper confusion matrix once `actualNoShow` is backfilled from the
/// booking's terminal status. `modelVersion` tracks which trained artifact
/// produced the score, for drift / train-serve-skew monitoring.
model BookingNoShowPrediction {
  id           String   @id @default(cuid())
  bookingId    String
  tenantId     String
  modelVersion String
  probability  Float
  predictedAt  DateTime @default(now())
  actualNoShow Boolean?
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([bookingId, modelVersion])
  @@index([tenantId, predictedAt])
  @@index([bookingId])
}

model PlatformPlan {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  description           String?
  priceMonthlyPence     Int
  trialDays             Int                    @default(30)
  maxMembers            Int                    @default(50)
  maxGreens             Int                    @default(2)
  includedStreamingTier StreamingTier          @default(NONE)
  featureFlags          Json?                  @default("{}")
  sortOrder             Int                    @default(0)
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  billingProfiles       TenantBillingProfile[]
}

model TenantBillingProfile {
  id                  String               @id @default(cuid())
  tenantId            String               @unique
  planId              String
  billingContactName  String?
  billingContactEmail String?
  billingAddress      Json?                @default("{}")
  vatNumber           String?
  paymentMethod       BillingPaymentMethod @default(INVOICE)
  billingStatus       BillingStatus        @default(TRIAL)
  currentPeriodStart  DateTime             @default(now())
  currentPeriodEnd    DateTime
  trialEndsAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  plan                PlatformPlan         @relation(fields: [planId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  payments            TenantPayment[]
}

model BookingPayment {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  amount      Int
  currency    String        @default("GBP")
  status      PaymentStatus @default(PENDING)
  checkoutUrl String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  booking     Booking       @relation(fields: [bookingId], references: [id])
}

model TenantPayment {
  id               String                @id @default(cuid())
  tenantId         String
  amount           Int
  currency         String                @default("GBP")
  status           PaymentStatus         @default(PENDING)
  invoiceRef       String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  billingProfileId String?
  pdfUrl           String?
  periodEnd        DateTime?
  periodStart      DateTime?
  type             PaymentType           @default(SUBSCRIPTION)
  lineItems        InvoiceLineItem[]
  billingProfile   TenantBillingProfile? @relation(fields: [billingProfileId], references: [id])
  tenant           Tenant                @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([billingProfileId])
}

model InvoiceLineItem {
  id              String              @id @default(cuid())
  paymentId       String
  description     String
  quantity        Int                 @default(1)
  unitPricePence  Int
  totalPricePence Int
  category        InvoiceLineCategory
  sortOrder       Int                 @default(0)
  payment         TenantPayment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model MaintenanceTask {
  id                String                 @id @default(cuid())
  tenantId          String
  title             String
  description       String
  category          TaskCategory           @default(GENERAL)
  priority          TaskPriority           @default(MEDIUM)
  status            TaskStatus             @default(SUBMITTED)
  submittedById     String
  assignedToId      String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  visibility        TaskVisibility         @default(MAINTENANCE_ONLY)
  assignedTo        User?                  @relation("AssignedTo", fields: [assignedToId], references: [id])
  submittedBy       User                   @relation("SubmittedBy", fields: [submittedById], references: [id])
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  agentInteractions TaskAgentInteraction[]
  notes             TaskNote[]

  @@index([tenantId, visibility, status])
}

model TaskNote {
  id        String          @id @default(cuid())
  taskId    String
  userId    String
  text      String
  createdAt DateTime        @default(now())
  task      MaintenanceTask @relation(fields: [taskId], references: [id])
  user      User            @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model AuditEvent {
  id               String   @id @default(cuid())
  timestamp        DateTime @default(now())
  tenantId         String?
  actorId          String
  actorRole        Role
  action           String
  entity           String
  entityId         String?
  piiAccess        Boolean  @default(false)
  meta             String?
  actingAsTenantId String?
  actingAsRole     Role?
  impersonationId  String?
  actor            User     @relation(fields: [actorId], references: [id])
  tenant           Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, timestamp])
  @@index([actorId, timestamp])
  @@index([entity, entityId])
  @@index([impersonationId])
}

/// Records a platform admin assuming a tenant role to act on behalf of a club.
/// Created when impersonation starts; `endedAt` set when explicitly exited.
model Impersonation {
  id             String    @id @default(cuid())
  platformUserId String
  tenantId       String
  assumedRole    Role      @default(TENANT_ADMIN)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  reason         String?
  platformUser   User      @relation(fields: [platformUserId], references: [id])
  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@index([platformUserId, startedAt])
  @@index([tenantId, startedAt])
}

model ContentSection {
  id          String        @id @default(cuid())
  tenantId    String
  type        SectionType
  status      ContentStatus @default(DRAFT)
  enabled     Boolean       @default(true)
  order       Int           @default(0)
  title       String
  content     String
  createdById String
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User          @relation("CreatedBy", fields: [createdById], references: [id])
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  updatedBy   User?         @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@index([tenantId, status])
}

model Event {
  id             String          @id @default(cuid())
  tenantId       String
  title          String
  description    String
  category       EventCategory   @default(SOCIAL)
  format         EventFormat?
  playerCount    PlayerCount?
  date           String
  startTime      String
  endTime        String?
  location       String?
  capacity       Int?
  entryFee       Int?
  currency       String          @default("GBP")
  imageUrl       String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  visibility     EventVisibility @default(MEMBERS_ONLY)
  status         String          @default("DRAFT")
  createdById    String
  updatedById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      User            @relation("EventCreatedBy", fields: [createdById], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  updatedBy      User?           @relation("EventUpdatedBy", fields: [updatedById], references: [id])
  streamSessions StreamSession[]

  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([visibility, status])
}

model Channel {
  id          String              @id @default(cuid())
  tenantId    String
  name        String
  description String?
  type        ChannelType         @default(PUBLIC)
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   User                @relation("ChannelCreatedBy", fields: [createdById], references: [id])
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  members     ChannelMember[]
  messages    Message[]
  readCursors MessageReadCursor[]

  @@unique([tenantId, name])
  @@index([tenantId, type])
}

model ChannelMember {
  id         String            @id @default(cuid())
  channelId  String
  userId     String
  role       ChannelMemberRole @default(MEMBER)
  mutedUntil DateTime?
  joinedAt   DateTime          @default(now())
  channel    Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id])

  @@unique([channelId, userId])
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  tenantId  String
  userId    String
  body      String
  pinned    Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([channelId, createdAt])
  @@index([tenantId, createdAt])
}

model MessageReadCursor {
  id                String   @id @default(cuid())
  channelId         String
  userId            String
  lastReadMessageId String
  updatedAt         DateTime @updatedAt
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model TrackingEvent {
  id                 String            @id @default(cuid())
  timestamp          DateTime          @default(now())
  tenantId           String?
  userId             String?
  sessionFingerprint String
  eventType          TrackingEventType
  path               String
  action             String?
  entity             String?
  entityId           String?
  browserFamily      String
  browserVersion     String?
  osFamily           String
  deviceType         String
  isPWA              Boolean           @default(false)
  meta               String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id])
  user               User?             @relation(fields: [userId], references: [id])

  @@index([tenantId, timestamp])
  @@index([eventType, timestamp])
  @@index([path, timestamp])
  @@index([sessionFingerprint])
}

/// Optional per-tenant override for a shipped help article.
/// Composite uniqueness on (tenantId, slug, locale): each tenant may override
/// each article in each locale at most once. Setting `enabled=false` hides the
/// shipped article for that tenant + locale; otherwise the override's `title`
/// and `body` replace the shipped values.
model HelpArticleOverride {
  id          String   @id @default(cuid())
  tenantId    String
  slug        String
  locale      String
  enabled     Boolean  @default(true)
  title       String?
  body        String?
  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("HelpOverrideCreatedBy", fields: [createdById], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  updatedBy   User?    @relation("HelpOverrideUpdatedBy", fields: [updatedById], references: [id])

  @@unique([tenantId, slug, locale])
  @@index([tenantId, slug])
}

model MaintenanceHistory {
  id            String                  @id @default(cuid())
  tenantId      String
  greenId       String?
  activityType  MaintenanceActivityType
  description   String?
  performedAt   DateTime
  performedById String?
  notes         String?
  createdAt     DateTime                @default(now())
  green         Green?                  @relation("GreenHistory", fields: [greenId], references: [id])
  performedBy   User?                   @relation("HistoryPerformedBy", fields: [performedById], references: [id])
  tenant        Tenant                  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, performedAt])
  @@index([greenId, performedAt])
}

model AgentDefinition {
  id             String                   @id @default(cuid())
  slug           String                   @unique
  name           String
  description    String?
  systemUserId   String                   @unique
  enabled        Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  preferredModel String?
  scope          AgentScope               @default(TENANT)
  usesLLM        AgentLlmUsage            @default(ALWAYS)
  metrics        AgentConfidenceMetrics[]
  configs        AgentConfig[]
  decisions      AgentDecision[]
  systemUser     User                     @relation(fields: [systemUserId], references: [id])
  knowledge      AgentKnowledge[]
  memories       AgentMemory[]
  proposals      AgentProposal[]
  runs           AgentRun[]
}

model AgentRun {
  id           String          @id @default(cuid())
  agentId      String
  tenantId     String?
  status       AgentRunStatus  @default(RUNNING)
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  summary      String?
  error        String?
  costsCents   Int             @default(0)
  federationId String?
  mode         AgentRunMode    @default(SCHEDULED)
  model        String?
  provider     String?
  scope        AgentScope      @default(TENANT)
  tokensIn     Int             @default(0)
  tokensOut    Int             @default(0)
  traceJson    String?
  userId       String?
  decisions    AgentDecision[]
  proposals    AgentProposal[]
  agent        AgentDefinition @relation(fields: [agentId], references: [id])
  tenant       Tenant?         @relation(fields: [tenantId], references: [id])

  @@index([tenantId, startedAt])
  @@index([agentId, startedAt])
  @@index([userId, startedAt])
}

model AgentDecision {
  id               String                 @id @default(cuid())
  agentId          String
  runId            String
  tenantId         String?
  action           AgentAction
  confidence       Float
  reasoning        String
  sourceMessageId  String?
  taskId           String?
  previousPriority TaskPriority?
  newPriority      TaskPriority?
  assignedToId     String?
  contextAdded     String?
  createdAt        DateTime               @default(now())
  proposalId       String?
  agent            AgentDefinition        @relation(fields: [agentId], references: [id])
  proposal         AgentProposal?         @relation(fields: [proposalId], references: [id])
