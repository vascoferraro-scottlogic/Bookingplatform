{
  "name": "bookingplatform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "restart": "(lsof -ti :3000 | xargs kill -9 2>/dev/null) ; npm run build && npm start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "migrate:deploy": "prisma migrate deploy",
    "setup:env": "node scripts/setup-env.mjs",
    "agent:detect": "node scripts/run-agent.mjs detector",
    "agent:noshow": "node scripts/run-agent.mjs no-show",
    "agent:triage": "node scripts/run-agent.mjs triager",
    "agent:all": "node scripts/run-agent.mjs all",
    "ml:serve": "dotenv -e .env -- python3 -m uvicorn serve:app --app-dir ml --port 8001 --reload",
    "ml:train": "python3 ml/train.py",
    "ml:retrain": "node scripts/run-ml.mjs retrain",
    "ml:drift": "node scripts/run-ml.mjs drift",
    "eval:noshow": "npx tsx scripts/eval-noshow.ts",
    "unleash:up": "docker compose up -d postgres unleash",
    "unleash:logs": "docker compose logs -f unleash",
    "stack:build": "node bin/stack.mjs build",
    "stack:up": "node bin/stack.mjs up -d --build",
    "stack:down": "node bin/stack.mjs down",
    "stack:logs": "node bin/stack.mjs logs -f",
    "stack:pull": "node bin/stack.mjs pull --ghcr",
    "stack:up:ghcr": "node bin/stack.mjs up --ghcr -d",
    "swap": "node bin/swap.mjs",
    "flags:migrate": "npx tsx scripts/migrate-flags-to-unleash.ts",
    "flags:parity": "npx tsx scripts/check-flag-parity.ts",
    "check:i18n": "scripts/check-i18n-coverage.sh",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@logtail/next": "^0.3.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.5.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "next": "^16.2.1",
    "next-auth": "^4.24.13",
    "next-intl": "^4.11.0",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "unleash-client": "^6.11.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "eslint": "^10.1.0",
    "jest": "^30.3.0",
    "jest-html-reporters": "^3.1.7",
    "postcss": "^8.5.8",
    "prisma": "^7.5.0",
    "tailwindcss": "^4.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
